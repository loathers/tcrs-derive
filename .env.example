# Copy to .env and fill in. tcrs reads this file itself, so do NOT export these
# into your shell: an exported environment is inherited by every JVM it spawns.
# .env is gitignored, so real passwords never get committed.
#
# Each multi has its own password variable, PASSWORD_<CLASS>_<SIGN>. If they all
# share one password, just set every line to the same value (a quick sed does it:
#   sed -i '' 's/=$/=thepassword/' .env   ).
#
# Optional overrides (defaults shown):
#   CONCURRENCY=4     # parallel accounts; keep modest to avoid KoL rate-limiting one IP
#   TIMEOUT=1800      # per-account seconds before the JVM is killed
#   ONLY=tt_wallaby   # comma-separated usernames to run a subset (smoke test)
#   EXCLUDE=sc_vole   # comma-separated usernames to skip
#   RESUME=1          # skip permutations whose 3 output files already exist

PASSWORD_SC_MONGOOSE=
PASSWORD_SC_WALLABY=
PASSWORD_SC_VOLE=
PASSWORD_SC_PLATYPUS=
PASSWORD_SC_OPOSSUM=
PASSWORD_SC_MARMOT=
